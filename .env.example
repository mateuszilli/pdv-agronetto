# Copy to .env and adjust as needed. Never commit the real .env.

# --- Postgres (docker-compose + Go backend) ---
POSTGRES_USER=pdv
POSTGRES_PASSWORD=pdv
POSTGRES_DB=pdv
POSTGRES_PORT=5432

# --- Go backend (api) ---
DATABASE_URL=postgres://pdv:pdv@localhost:5432/pdv?sslmode=disable
JWT_SECRET=dev-secret-change-me
PORT=8080

# --- Tauri client (app) ---
# Base URL the client's auth command calls for POST /auth/login.
PDV_BACKEND_URL=http://localhost:8080

# --- Fiscal provider (Focus NFe) — plan section 5 ---
# Leave FISCAL_PROVIDER_TOKEN unset for local dev: emission stays queued
# ("mock mode") and nothing blocks — see README's fiscal section.
# FISCAL_PROVIDER_TOKEN=your-focus-nfe-sandbox-token
# FISCAL_ENV=homologacao   # or "producao" — never test production with a real CNPJ
# FISCAL_ISSUER_CNPJ=00000000000000

# --- Receipt printer (ESC/POS) — plan section 6 ---
# console (default) | network:<host>:<port> | serial:<path>[:baud] | file:<path>
# PDV_PRINTER=console
