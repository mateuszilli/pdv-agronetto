# Copy to .env and adjust as needed. Never commit the real .env.

# --- Postgres (docker-compose + Go backend) ---
POSTGRES_USER=pdv
POSTGRES_PASSWORD=pdv
POSTGRES_DB=pdv
POSTGRES_PORT=5432

# --- Go backend (apps/backend) ---
DATABASE_URL=postgres://pdv:pdv@localhost:5432/pdv?sslmode=disable
JWT_SECRET=dev-secret-change-me
PORT=8080

# --- Tauri client (apps/client) ---
# Base URL the client's auth command calls for POST /auth/login.
PDV_BACKEND_URL=http://localhost:8080
